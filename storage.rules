rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all architectural photography, videos, and media
    match /{allPaths=**} {
      allow read: if true;
      // Client write access permitted only for authenticated admin studio users (e.g. photo uploads)
      allow write: if request.auth != null;
    }

    // CMS data is managed strictly server-side via Firebase Admin SDK.
    // Browser client direct writes are strictly disallowed.
    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
