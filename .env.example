# Techno Architecture - Environment Configuration Example
# Copy this file to .env.local and set your private credentials.
# DO NOT put real production credentials in this example file.

# Admin Portal Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SESSION_SECRET=your_random_session_secret_key

# Firebase Cloud Firestore & Storage
# Option A: Paste entire Service Account JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: Individual Service Account fields from downloaded JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Enquiry Notification Routing
RAJESH_EMAIL=rajesh@technoarchitecture.in
ENQUIRY_EMAIL=technoarchitecture@gmail.com
RESEND_API_KEY=
EMAIL_FROM=Techno Architecture <notifications@technoarchitecture.in>
