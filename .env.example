# Techno Architecture - Environment Configuration Example
# Copy this file to .env.local and set your private credentials.
# DO NOT put real production credentials in this example file.

# ─────────────────────────────────────────────────────────────
# 1. Admin Portal Authentication (REQUIRED FOR CMS ACCESS)
# ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SESSION_SECRET=your_random_session_secret_key_minimum_32_characters

# ─────────────────────────────────────────────────────────────
# 2. Firebase Cloud Storage & Admin SDK (REQUIRED FOR VERCEL CMS PERSISTENCE)
# ─────────────────────────────────────────────────────────────
# On Vercel, the local filesystem is read-only (EROFS) and /tmp is ephemeral.
# To ensure CMS changes persist permanently across redeploys, cold starts,
# and multiple serverless lambdas, configure the Firebase Admin credentials below:
FIREBASE_PROJECT_ID=technoarchitecture-7d718
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@technoarchitecture-7d718.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=technoarchitecture-7d718.firebasestorage.app

# Optional single-line JSON credential alternative to the three vars above:
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─────────────────────────────────────────────────────────────
# 3. Firebase Client Configuration (Web SDK)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=technoarchitecture-7d718.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=technoarchitecture-7d718
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=technoarchitecture-7d718.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=361435214203
NEXT_PUBLIC_FIREBASE_APP_ID=1:361435214203:web:27a627d1dac7458d7e4dde

# ─────────────────────────────────────────────────────────────
# 4. Google Workspace / Gmail SMTP Configuration (Enquiry Dispatch)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rajesh@technoarchitecture.co.in
SMTP_PASS=your_16_character_app_password

# Enquiry Notification Routing
PRIMARY_TO_EMAIL=rajesh@technoarchitecture.co.in
PERMANENT_CC_EMAIL=enquiries@technoarchitecture.co.in

# ─────────────────────────────────────────────────────────────
# 5. Optional Integrations
# ─────────────────────────────────────────────────────────────
# GitHub Direct Auto-Commit Integration (Optional Vercel Sync)
GITHUB_TOKEN=
GITHUB_REPOSITORY=Amanrck96/Techno-Architecture

# Upstash Redis KV (Optional secondary fast cache)
KV_REST_API_URL=
KV_REST_API_TOKEN=
